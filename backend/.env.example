# Copy this file to backend/.env. Never commit .env or real keys.
# Browser-visible settings belong in frontend/.env.
APP_ENV=development
APP_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SUPABASE_URL=https://your-project.supabase.co
# Use a publishable or legacy anon key, never a service_role key.
SUPABASE_PUBLISHABLE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=18
MAX_UPLOAD_BYTES=3145728
SCAN_RATE_LIMIT=10
AUTH_RATE_LIMIT=15
